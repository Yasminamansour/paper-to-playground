 "reference_js": "function reference(state) {\n  const Q = state.Q, K = state.K, V = state.V;\n  const dk = K[0].length;\n  const s = state.scale ? 1/Math.sqrt(dk) : 1;\n  const scores = Q.map(q => K.map(k => q.reduce((a,x,i)=>a+x*k[i],0)*s));\n  const weights = scores.map(row => {\n    const m = Math.max(...row);\n    const e = row.map(x => Math.exp(x-m));\n    const z = e.reduce((a,b)=>a+b,0);\n    return e.map(x => x/z);\n  });\n  const output = weights.map(w => V[0].map((_,j) => w.reduce((a,wi,i)=>a+wi*V[i][j],0)));\n  return {scores, weights, output};\n}",
 "invariants": [
  {
   "name": "rows sum to one",
   "js": "out.weights.every(r => Math.abs(r.reduce((a,b)=>a+b,0) - 1) < 1e-9)"
  },
  {
   "name": "output is weighted sum of V",
   "js": "out.output.every((r,i) => r.every((x,j) => Math.abs(x - out.weights[i].reduce((a,w,k)=>a+w*state.V[k][j],0)) < 1e-9))"
  },
  {
   "name": "weights nonnegative",
   "js": "out.weights.every(r => r.every(x => x >= 0))"
  }
 ],
